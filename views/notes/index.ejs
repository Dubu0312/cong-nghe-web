<%- include("../partials/header", { pageTitle: "Ghi chú của tôi" }) %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="h4 mb-0">Ghi chú của tôi</h1>
  <a href="/notes/new" class="btn btn-primary">Tạo ghi chú</a>
</div>

<!-- Bộ lọc dùng GET để trạng thái tìm kiếm nằm trên URL, chia sẻ và tải lại được. -->
<form method="get" action="/notes" class="card card-body shadow-sm mb-3">
  <div class="row g-2">
    <div class="col-12 col-md-5">
      <label for="q" class="form-label small mb-1">Tìm kiếm</label>
      <input
        type="search"
        class="form-control"
        id="q"
        name="q"
        value="<%= filters.q %>"
        placeholder="Tiêu đề hoặc nội dung"
      />
    </div>

    <div class="col-6 col-md-3">
      <label for="category" class="form-label small mb-1">Danh mục</label>
      <select class="form-select" id="category" name="category">
        <option value="">Tất cả</option>
        <% categories.forEach(function (item) { %>
          <option value="<%= item.value %>" <%= filters.category === item.value ? "selected" : "" %>>
            <%= item.label %>
          </option>
        <% }); %>
      </select>
    </div>

    <div class="col-6 col-md-4">
      <label for="sort" class="form-label small mb-1">Sắp xếp</label>
      <select class="form-select" id="sort" name="sort">
        <% sortOptions.forEach(function (option) { %>
          <option value="<%= option.value %>" <%= filters.sort === option.value ? "selected" : "" %>>
            <%= option.label %>
          </option>
        <% }); %>
      </select>
    </div>
  </div>

  <div class="d-flex gap-2 mt-3">
    <button type="submit" class="btn btn-secondary">Áp dụng</button>
    <% if (hasFilters) { %>
      <a href="/notes" class="btn btn-outline-secondary">Xóa bộ lọc</a>
    <% } %>
  </div>
</form>

<% if (notes.length === 0) { %>
  <div class="card card-body text-center py-5 shadow-sm">
    <% if (hasFilters) { %>
      <p class="h5">Không có kết quả phù hợp</p>
      <p class="text-secondary mb-3">Thử từ khóa khác hoặc bỏ bớt điều kiện lọc.</p>
      <div><a href="/notes" class="btn btn-outline-secondary">Xóa bộ lọc</a></div>
    <% } else { %>
      <p class="h5">Bạn chưa có ghi chú nào</p>
      <p class="text-secondary mb-3">Bắt đầu bằng ghi chú đầu tiên nhé.</p>
      <div><a href="/notes/new" class="btn btn-primary">Tạo ghi chú đầu tiên</a></div>
    <% } %>
  </div>
<% } else { %>
  <p class="text-secondary small">
    Tìm thấy <%= pagination.totalItems %> ghi chú ·
    trang <%= pagination.page %>/<%= pagination.totalPages %>
  </p>

  <div class="row row-cols-1 row-cols-md-2 g-3">
    <% notes.forEach(function (note) { %>
      <div class="col">
        <article class="card h-100 shadow-sm">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <h2 class="h6 mb-1">
                <a class="stretched-link-none text-decoration-none" href="/notes/<%= note.id %>">
                  <%= note.title %>
                </a>
              </h2>
              <% if (note.is_pinned) { %>
                <span class="badge text-bg-warning flex-shrink-0" title="Đã ghim">Ghim</span>
              <% } %>
            </div>

            <div class="mb-2">
              <span class="badge text-bg-light border"><%= categoryLabels[note.category] %></span>
            </div>

            <p class="text-secondary small flex-grow-1"><%= excerpt(note.content) %></p>

            <div class="text-secondary small mb-2">
              Cập nhật: <%= formatDateTime(note.updated_at) %>
            </div>

            <div class="d-flex flex-wrap gap-2">
              <a href="/notes/<%= note.id %>" class="btn btn-sm btn-outline-secondary">Xem</a>
              <a href="/notes/<%= note.id %>/edit" class="btn btn-sm btn-outline-secondary">Sửa</a>
              <form
                method="post"
                action="/notes/<%= note.id %>/delete"
                data-confirm="Xóa ghi chú “<%= note.title %>”?"
              >
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
              </form>
            </div>
          </div>
        </article>
      </div>
    <% }); %>
  </div>

  <% if (pagination.totalPages > 1) { %>
    <%
      // Giữ nguyên q/category/sort khi chuyển trang.
      function pageLink(page) {
        const params = new URLSearchParams();
        if (filters.q) params.set("q", filters.q);
        if (filters.category) params.set("category", filters.category);
        if (filters.sort) params.set("sort", filters.sort);
        params.set("page", page);
        return "/notes?" + params.toString();
      }
    %>
    <nav class="mt-4" aria-label="Phân trang">
      <ul class="pagination justify-content-center flex-wrap">
        <li class="page-item <%= pagination.page === 1 ? "disabled" : "" %>">
          <a class="page-link" href="<%= pageLink(pagination.page - 1) %>">Trước</a>
        </li>

        <% for (let p = 1; p <= pagination.totalPages; p++) { %>
          <li class="page-item <%= p === pagination.page ? "active" : "" %>">
            <a class="page-link" href="<%= pageLink(p) %>"><%= p %></a>
          </li>
        <% } %>

        <li class="page-item <%= pagination.page === pagination.totalPages ? "disabled" : "" %>">
          <a class="page-link" href="<%= pageLink(pagination.page + 1) %>">Sau</a>
        </li>
      </ul>
    </nav>
  <% } %>
<% } %>

<%- include("../partials/footer") %>
