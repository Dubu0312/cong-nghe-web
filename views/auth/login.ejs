<%- include("../partials/header", { pageTitle: "Đăng nhập" }) %>

<div class="row justify-content-center">
  <div class="col-md-7 col-lg-5">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-4">Đăng nhập</h1>

        <% if (errors.form) { %>
          <div class="alert alert-danger" role="alert"><%= errors.form %></div>
        <% } %>

        <form method="post" action="/auth/login" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input
              type="email"
              class="form-control <%= errors.email ? 'is-invalid' : '' %>"
              id="email"
              name="email"
              value="<%= values.email || '' %>"
              autocomplete="email"
              required
            />
            <% if (errors.email) { %>
              <div class="invalid-feedback"><%= errors.email %></div>
            <% } %>
          </div>

          <div class="mb-3">
            <label for="password" class="form-label">Mật khẩu</label>
            <input
              type="password"
              class="form-control <%= errors.password ? 'is-invalid' : '' %>"
              id="password"
              name="password"
              autocomplete="current-password"
              required
            />
            <% if (errors.password) { %>
              <div class="invalid-feedback"><%= errors.password %></div>
            <% } %>
          </div>

          <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
        </form>

        <p class="mt-3 mb-0 text-center small">
          Chưa có tài khoản? <a href="/auth/register">Đăng ký</a>
        </p>
      </div>
    </div>

    <div class="alert alert-secondary mt-3 small mb-0">
      <strong>Tài khoản demo</strong><br />
      Email: <code>demo@example.com</code><br />
      Mật khẩu: <code>Demo@12345</code>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>
