<% if (currentUser && chatEnabled) { %>
  <!-- Trợ lý hỏi đáp. Chỉ hiện khi đã đăng nhập và đã cấu hình API key. -->
  <div id="chat-widget" data-csrf="<%= csrfToken %>">
    <button type="button" id="chat-toggle" class="btn btn-primary btn-lg rounded-pill shadow">
      Trợ lý ghi chú
    </button>

    <div id="chat-panel" class="card shadow-lg d-none">
      <div class="card-header d-flex justify-content-between align-items-center">
        <div>
          <strong>Trợ lý ghi chú</strong>
          <div class="text-secondary" style="font-size: 0.75rem">
            Hỏi bất cứ điều gì về ghi chú của bạn
          </div>
        </div>
        <button type="button" id="chat-close" class="btn-close" aria-label="Đóng"></button>
      </div>

      <div class="card-body">
        <div id="chat-log">
          <div class="chat-row chat-bot">
            <div class="chat-bubble">
              Chào bạn! Mình có thể tra cứu và tóm tắt ghi chú của bạn. Cứ hỏi
              tự nhiên nhé.
            </div>
          </div>
        </div>

        <div class="chat-suggestions small text-secondary mb-2">
          <% chatExamples.forEach(function (ex) { %>
            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 mb-1 chat-example">
              <%= ex %>
            </button>
          <% }); %>
        </div>

        <form id="chat-form" class="d-flex gap-2">
          <input
            type="text"
            id="chat-input"
            class="form-control"
            placeholder="Nhắn cho trợ lý…"
            maxlength="300"
            autocomplete="off"
          />
          <button type="submit" class="btn btn-primary">Gửi</button>
        </form>
      </div>
    </div>
  </div>
<% } %>
