<% if (currentUser && chatEnabled) { %>
  <!-- Khung hỏi đáp nổi. Chỉ hiện khi đã đăng nhập và đã cấu hình API key. -->
  <div id="chat-widget" data-csrf="<%= csrfToken %>">
    <button type="button" id="chat-toggle" class="btn btn-primary rounded-pill shadow">
      Hỏi về ghi chú
    </button>

    <div id="chat-panel" class="card shadow d-none">
      <div class="card-header d-flex justify-content-between align-items-center py-2">
        <strong class="small">Hỏi về ghi chú của bạn</strong>
        <button type="button" id="chat-close" class="btn-close" aria-label="Đóng"></button>
      </div>

      <div class="card-body py-2">
        <div id="chat-log" class="small"></div>

        <div class="small text-secondary mb-2">
          Gợi ý:
          <% chatExamples.forEach(function (ex) { %>
            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 mb-1 chat-example">
              <%= ex %>
            </button>
          <% }); %>
        </div>

        <form id="chat-form" class="d-flex gap-2">
          <input
            type="text"
            id="chat-input"
            class="form-control form-control-sm"
            placeholder="Nhập câu hỏi…"
            maxlength="300"
            autocomplete="off"
          />
          <button type="submit" class="btn btn-sm btn-primary">Gửi</button>
        </form>

        <div class="form-text mt-1" style="font-size: 0.72rem">
          Hỏi nối tiếp được. Tải lại trang là xóa hội thoại.
        </div>
      </div>
    </div>
  </div>
<% } %>
