# Sao chép file này thành .env rồi chỉnh giá trị cho phù hợp.

NODE_ENV=development
PORT=3000

# 0.0.0.0 = nghe trên mọi network interface, máy khác trong cùng mạng vào được.
# Đổi thành 127.0.0.1 nếu chỉ muốn mở cho riêng máy này.
HOST=0.0.0.0

# Bắt buộc đổi khi deploy production. Sinh chuỗi ngẫu nhiên bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

DATABASE_PATH=./data/app.db
BCRYPT_ROUNDS=12

# Tài khoản demo do seed tạo ra, ghi trong README và nộp cho giảng viên.
# DEMO_EMAIL nhận cả email lẫn mã học viên.
DEMO_EMAIL=20242507M
DEMO_PASSWORD=12345678
